# Database Configuration
# Nama database harus sama dengan yang dibuat di MySQL: skinmatch
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skinmatch

# JWT Configuration
SECRET_KEY=your-secret-key-here-minimum-32-characters-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# Server Configuration (optional)
HOST=0.0.0.0
PORT=8000

# Environment
ENV=development
